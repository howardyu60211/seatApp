{
  "name": "seatapp",
  "productName": "seatapp",
  "version": "1.0.0",
  "description": "學生座位編排程式 — 建立座位表、匯入名單、隨機分配並匯出 XLSX / PDF / PNG",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "make": "electron-forge make",
    "dist": "electron-builder build --win portable"
  },
  "build": {
    "appId": "com.howardyu.seatapp",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".vite/**",
      "package.json",
      "!node_modules/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-TW"
    ],
    "compression": "maximum",
    "asar": true,
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "^43.4.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21"
  },
  "keywords": [],
  "author": {
    "name": "Howard yu",
    "email": "howard60211@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "electron-squirrel-startup": "^1.0.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  }
}
